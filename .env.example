# Atlas application
ATLAS_LLM_PROVIDER=extractive
ATLAS_BOOTSTRAP_DEMO=true
ATLAS_DB_PATH=data/vector-store/chroma
ATLAS_MANIFEST_PATH=data/vector-store/index-manifest.json
ATLAS_INVENTORY_PATH=knowledge-base/document-inventory.csv
ATLAS_EMBEDDING_PROVIDER=fastembed
ATLAS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ATLAS_EMBEDDING_CACHE_DIR=.cache/fastembed
ATLAS_RERANKER=hybrid
ATLAS_CANDIDATE_K=12
ATLAS_FINAL_K=4
ATLAS_MIN_EVIDENCE_SCORE=0.20
ATLAS_EVENTS_PATH=data/feedback/events.jsonl
ATLAS_LOG_QUERY_TEXT=false

# OCI Generative AI: required only when ATLAS_LLM_PROVIDER=oci
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..REEMPLAZAR
OCI_GENAI_MODEL_ID=REEMPLAZAR_CON_MODEL_ID
OCI_AUTH_MODE=config_file
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_GENAI_ENDPOINT=
